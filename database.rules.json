{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "assetComments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$asset": {
        "$comment": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists()",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000 && newData.child('author').isString() && newData.child('author').val().length <= 120 && newData.child('at').isNumber()"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/)",
        "seats": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists() && data.parent().parent().child('status').val() === 'lobby'",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('crew').isString() && newData.child('crew').val().length <= 24 && newData.child('joinedAt').isNumber())"
          }
        },
        "intents": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('seats').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.child('n').isNumber() && newData.child('c').isNumber())"
          }
        }
      }
    }
  }
}
