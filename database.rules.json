{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "assetComments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$asset": {
        "$comment": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists()",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000 && newData.child('author').isString() && newData.child('author').val().length <= 120 && newData.child('at').isNumber()"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/)",
        "seats": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('host').exists() && data.parent().parent().child('status').val() === 'lobby'",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('crew').isString() && newData.child('crew').val().length <= 24 && newData.child('joinedAt').isNumber())"
          }
        },
        "intents": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('seats').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.child('n').isNumber() && newData.child('c').isNumber())"
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (data.child('hostUid').val() === auth.uid || (!data.exists() && newData.child('hostUid').val() === auth.uid))",
        ".validate": "!newData.exists() || ($code.matches(/^[A-Z2-9]{5}$/) && newData.child('host').isString() && newData.child('host').val().length <= 24 && newData.child('seats').isNumber())"
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && newData.val() === auth.uid",
        ".validate": "$name.matches(/^[a-z0-9_]([a-z0-9_.]{1,18})[a-z0-9_]$/)"
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && !data.exists() && newData.val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('at').isNumber()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.child('user').isString() && root.child('usernames').child(newData.child('user').val()).val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('code').isString() && newData.child('at').isNumber()"
        },
        "friends": {
          "$other": {
            ".read": "auth != null && auth.uid === $other",
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || auth.token.firebase.sign_in_provider !== 'anonymous')",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('at').isNumber())"
          }
        },
        "requests": {
          "$from": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $from && auth.token.firebase.sign_in_provider !== 'anonymous'))",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('at').isNumber())"
          }
        },
        "invites": {
          "$code": {
            ".write": "auth != null && (auth.uid === $uid || (auth.token.firebase.sign_in_provider !== 'anonymous' && newData.child('from').val() === auth.uid && root.child('users').child($uid).child('friends').child(auth.uid).exists()))",
            ".validate": "!newData.exists() || ($code.matches(/^[A-Z2-9]{5}$/) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('at').isNumber())"
          }
        },
        "games": {
          "$code": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || ($code.matches(/^[A-Z2-9]{5}$/) && newData.child('at').isNumber())"
          }
        }
      }
    }
  }
}
